generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ============================================================
//  ADMIN GİRİŞİ
// ============================================================
model Kullanici {
  id        String   @id @default(cuid())
  email     String   @unique
  sifreHash String // şifre asla düz metin saklanmaz
  ad        String
  olusturma DateTime @default(now())
}

// ============================================================
//  ÜRÜNLER
// ============================================================
model Kategori {
  id      String @id @default(cuid())
  ad      String @unique
  slug    String @unique // adres için: "kisiye-ozel-parsomenler"
  sira    Int    @default(0)
  urunler Urun[] // bu kategorideki ürünler
}

model Urun {
  id          String         @id @default(cuid())
  ad          String
  slug        String         @unique
  aciklama    String
  kategoriId  String
  kategori    Kategori       @relation(fields: [kategoriId], references: [id])
  gorseller   UrunGorsel[]
  eskiSluglar UrunEskiSlug[]
  oneCikan    Boolean        @default(false) // ana sayfada gösterilsin mi?
  yayinda     Boolean        @default(true) // false ise siteden gizlenir
  olusturma   DateTime       @default(now())
  guncelleme  DateTime       @updatedAt

  @@index([kategoriId])
  @@index([oneCikan])
}

model UrunGorsel {
  id       String  @id @default(cuid())
  urunId   String
  urun     Urun    @relation(fields: [urunId], references: [id], onDelete: Cascade)
  url      String
  publicId String // görseli silmek için gerekli kimlik
  alt      String? // görme engelliler ve Google için açıklama

  // Fotoğrafın gerçek en-boy oranını bilmek için. Detay sayfasında
  // görseli kendi oranında gösteriyoruz, böylece hiçbir şey kırpılmıyor.
  // Boş olabilir: bu alanlar eklenmeden önce yüklenmiş görseller var.
  genislik  Int?
  yukseklik Int?

  sira Int @default(0) // 0 = kapak görseli

  @@index([urunId])
}

// Ürün adı değişince adresi de değişiyor. Eski adresi burada saklayıp
// yeni adrese yönlendiriyoruz — paylaşılmış bağlantılar kırılmasın.
model UrunEskiSlug {
  id        String   @id @default(cuid())
  slug      String   @unique
  urunId    String
  urun      Urun     @relation(fields: [urunId], references: [id], onDelete: Cascade)
  olusturma DateTime @default(now())

  @@index([urunId])
}

// ============================================================
//  DUYURU VE ETKİNLİKLER
// ============================================================
enum DuyuruTuru {
  DUYURU
  ETKINLIK
}

model Duyuru {
  id             String           @id @default(cuid())
  tur            DuyuruTuru       @default(DUYURU)
  baslik         String
  slug           String           @unique
  aciklama       String
  kapakUrl       String?
  kapakPublicId  String?
  // Detay sayfasında kapağı kendi oranında göstermek için
  kapakGenislik  Int?
  kapakYukseklik Int?
  tarih          DateTime? // etkinlik tarihi
  yer            String? // etkinlik yeri
  yayinda        Boolean          @default(true)
  olusturma      DateTime         @default(now())
  guncelleme     DateTime         @updatedAt
  eskiSluglar    DuyuruEskiSlug[]
}

// Başlık değişince adres de değişiyor; eski adresi saklayıp yeni
// adrese yönlendiriyoruz. Paylaşılmış duyuru bağlantıları kırılmasın.
model DuyuruEskiSlug {
  id        String   @id @default(cuid())
  slug      String   @unique
  duyuruId  String
  duyuru    Duyuru   @relation(fields: [duyuruId], references: [id], onDelete: Cascade)
  olusturma DateTime @default(now())

  @@index([duyuruId])
}

// ============================================================
//  GALERİ
// ============================================================
enum GaleriTuru {
  ATOLYE
  URETIM
  ETKINLIK
  STAND
  MUSTERI
  DIGER
}

// Fotoğraflar albümlerde toplanıyor. Düz bir yığın olsaydı üç farklı
// kermesin fotoğrafları tek duvarda karışırdı; ziyaretçi hangi fotoğrafın
// hangi etkinlikten olduğunu anlayamazdı.
model GaleriAlbum {
  id         String       @id @default(cuid())
  ad         String
  slug       String       @unique
  aciklama   String?
  tur        GaleriTuru   @default(DIGER)
  tarih      DateTime?
  yayinda    Boolean      @default(true)
  olusturma  DateTime     @default(now())
  guncelleme DateTime     @updatedAt
  fotolar    GaleriFoto[]

  @@index([tur])
}

model GaleriFoto {
  id        String      @id @default(cuid())
  albumId   String
  album     GaleriAlbum @relation(fields: [albumId], references: [id], onDelete: Cascade)
  url       String
  publicId  String
  aciklama  String?
  genislik  Int?
  yukseklik Int?
  sira      Int         @default(0)
  olusturma DateTime    @default(now())

  @@index([albumId])
}

// ============================================================
//  İLETİŞİM FORMU MESAJLARI
// ============================================================
model Mesaj {
  id        String   @id @default(cuid())
  adSoyad   String
  email     String
  konu      String
  icerik    String
  okundu    Boolean  @default(false)
  olusturma DateTime @default(now())

  @@index([okundu])
}

// ============================================================
//  SIKÇA SORULAN SORULAR
// ============================================================
model SoruCevap {
  id      String  @id @default(cuid())
  soru    String
  cevap   String
  sira    Int     @default(0)
  yayinda Boolean @default(true)
}

// ============================================================
//  SİTE AYARLARI  (tek satırlık tablo)
//  Panelden düzenlenecek her şey burada
// ============================================================
model SiteAyar {
  id String @id @default("tek")

  // Ana sayfa kapağı — panelden yüklenip değiştirilebiliyor
  slogan         String?
  kapakAciklama  String?
  kapakUrl       String?
  kapakPublicId  String?
  kapakGenislik  Int?
  kapakYukseklik Int?

  // İletişim
  telefon  String?
  whatsapp String?
  email    String?
  adres    String?
  mapsUrl  String?

  // Çalışma saatleri
  calismaSaatleri String?

  // Sosyal medya
  instagram String?
  facebook  String?
  youtube   String?

  // Hakkımızda sayfası metinleri
  hikaye         String?
  sahipAdi       String?
  sahipBiyografi String?
  malzemeBilgi   String?

  guncelleme DateTime @updatedAt
}
